<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Agente de Planos — Novalyze AI</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Mono:wght@400;500&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg:#0f0f12; --surface:#17171d; --border:#2a2a35;
    --accent:#c9a84c; --accent2:#7eb8a4; --text:#e8e6df;
    --muted:#7a7870; --danger:#e07060;
  }
  * { box-sizing:border-box; margin:0; padding:0; }
  body { font-family:'DM Sans',sans-serif; background:var(--bg); color:var(--text); min-height:100vh; display:grid; grid-template-rows:auto 1fr; }
  header { border-bottom:1px solid var(--border); padding:1.1rem 2.5rem; display:flex; align-items:center; justify-content:space-between; background:var(--surface); }
  .logo { font-family:'DM Serif Display',serif; font-size:1.35rem; color:var(--accent); }
  .logo span { color:var(--text); font-style:italic; }
  .badge { font-family:'DM Mono',monospace; font-size:0.7rem; color:var(--muted); border:1px solid var(--border); padding:0.25rem 0.6rem; border-radius:2rem; }
  .workspace { display:grid; grid-template-columns:380px 1fr; height:calc(100vh - 62px); overflow:hidden; }
  .sidebar { border-right:1px solid var(--border); overflow-y:auto; padding:1.5rem; display:flex; flex-direction:column; gap:1.4rem; background:var(--surface); }
  .section-label { font-family:'DM Mono',monospace; font-size:0.65rem; letter-spacing:0.12em; color:var(--muted); text-transform:uppercase; margin-bottom:0.6rem; }
  .field { display:flex; flex-direction:column; gap:0.4rem; margin-bottom:0.75rem; }
  .field label { font-size:0.8rem; color:var(--muted); }
  .field input, .field select, .field textarea { background:var(--bg); border:1px solid var(--border); color:var(--text); border-radius:6px; padding:0.55rem 0.75rem; font-family:'DM Sans',sans-serif; font-size:0.85rem; width:100%; }
  .field input:focus, .field select:focus, .field textarea:focus { outline:none; border-color:var(--accent); }
  .field textarea { resize:vertical; min-height:70px; }
  .row2 { display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; }
  .rooms-grid { display:grid; grid-template-columns:1fr 1fr; gap:0.4rem; }
  .room-chip { display:flex; align-items:center; gap:0.4rem; background:var(--bg); border:1px solid var(--border); border-radius:6px; padding:0.4rem 0.6rem; cursor:pointer; font-size:0.78rem; user-select:none; }
  .room-chip:hover { border-color:var(--accent); }
  .room-chip input[type=checkbox] { accent-color:var(--accent); width:14px; height:14px; }
  .room-chip.checked { border-color:var(--accent); background:rgba(201,168,76,0.07); }
  .upload-zone { border:1.5px dashed var(--border); border-radius:8px; padding:1.2rem; text-align:center; cursor:pointer; position:relative; }
  .upload-zone:hover { border-color:var(--accent2); }
  .upload-zone input { position:absolute; inset:0; opacity:0; cursor:pointer; }
  .upload-zone .icon { font-size:1.6rem; margin-bottom:0.4rem; }
  .upload-zone p { font-size:0.78rem; color:var(--muted); }
  .preview-strip { display:flex; gap:0.5rem; flex-wrap:wrap; margin-top:0.6rem; }
  .preview-thumb { width:60px; height:60px; object-fit:cover; border-radius:4px; border:1px solid var(--border); }
  .btn-generate { width:100%; padding:0.85rem; background:var(--accent); color:#0f0f12; border:none; border-radius:8px; font-family:'DM Sans',sans-serif; font-weight:600; font-size:0.9rem; cursor:pointer; letter-spacing:0.04em; }
  .btn-generate:hover { opacity:0.88; }
  .btn-generate:disabled { opacity:0.4; cursor:not-allowed; }
  .canvas-area { display:flex; flex-direction:column; overflow:hidden; }
  .canvas-toolbar { display:flex; align-items:center; justify-content:space-between; padding:0.75rem 1.5rem; border-bottom:1px solid var(--border); background:var(--surface); }
  .canvas-toolbar .info { font-size:0.78rem; color:var(--muted); font-family:'DM Mono',monospace; }
  .download-group { display:flex; gap:0.5rem; }
  .btn-dl { padding:0.45rem 1rem; border-radius:6px; font-size:0.8rem; font-weight:500; cursor:pointer; border:1px solid; text-decoration:none; display:inline-flex; align-items:center; gap:0.4rem; }
  .btn-dl.pdf { color:var(--danger); border-color:var(--danger); background:transparent; }
  .btn-dl.dxf { color:var(--accent2); border-color:var(--accent2); background:transparent; }
  .btn-dl.hidden { display:none; }
  .canvas-viewport { flex:1; overflow:auto; position:relative; background:var(--bg); background-image:linear-gradient(rgba(255,255,255,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.02) 1px,transparent 1px); background-size:40px 40px; }
  .state-screen { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:1rem; text-align:center; padding:2rem; }
  .state-screen .big-icon { font-size:3rem; opacity:0.3; }
  .state-screen h3 { font-family:'DM Serif Display',serif; font-size:1.3rem; color:var(--muted); }
  .state-screen p { font-size:0.82rem; color:var(--muted); max-width:320px; line-height:1.6; }
  .loading-screen { display:none; }
  .spinner { width:40px; height:40px; border:3px solid var(--border); border-top-color:var(--accent); border-radius:50%; animation:spin 0.8s linear infinite; }
  @keyframes spin { to { transform:rotate(360deg); } }
  .loading-steps { font-family:'DM Mono',monospace; font-size:0.75rem; color:var(--muted); }
  .loading-steps .step { opacity:0.4; transition:opacity 0.3s; }
  .loading-steps .step.active { opacity:1; color:var(--accent); }
  #floor-plan-container { padding:2rem 3rem; display:none; min-width:100%; min-height:100%; }
  .error-msg { background:rgba(224,112,96,0.1); border:1px solid var(--danger); color:var(--danger); border-radius:8px; padding:0.75rem 1rem; font-size:0.82rem; display:none; }
</style>
</head>
<body>
<header>
  <div class="logo">Novalyze <span>Planos AI</span></div>
  <div class="badge">v1.0 · Colombia · NSR-10</div>
</header>
<div class="workspace">
  <aside class="sidebar">
    <div>
      <div class="section-label">📐 Proyecto</div>
      <div class="field"><label>Nombre del proyecto</label><input id="project_name" type="text" value="Casa de mis papás"/></div>
      <div class="field"><label>Ubicación</label><input id="location" type="text" placeholder="Rionegro, Antioquia"/></div>
    </div>
    <div>
      <div class="section-label">🗺️ Terreno</div>
      <div class="row2">
        <div class="field"><label>Frente (m)</label><input id="terrain_width" type="number" step="0.5" value="10"/></div>
        <div class="field"><label>Fondo (m)</label><input id="terrain_depth" type="number" step="0.5" value="20"/></div>
      </div>
      <div class="field"><label>Orientación del frente</label>
        <select id="orientation">
          <option>Norte</option><option>Sur</option><option>Este</option><option>Oeste</option><option>No sé</option>
        </select>
      </div>
      <div class="field"><label>Número de pisos</label>
        <select id="floors"><option value="1">1 piso</option><option value="2">2 pisos</option></select>
      </div>
    </div>
    <div>
      <div class="section-label">🏠 Espacios requeridos</div>
      <div class="rooms-grid" id="rooms-grid"></div>
    </div>
    <div>
      <div class="section-label">📝 Observaciones</div>
      <div class="field"><textarea id="notes" placeholder="Ej: patio grande, cocina interior, habitación principal con baño propio…"></textarea></div>
    </div>
    <div>
      <div class="section-label">📸 Fotos del terreno (opcional)</div>
      <div class="upload-zone">
        <input type="file" id="photo-input" accept="image/*" multiple/>
        <div class="icon">🏔️</div>
        <p>Arrastra fotos del lote o haz clic</p>
      </div>
      <div class="preview-strip" id="preview-strip"></div>
    </div>
    <div class="error-msg" id="error-msg"></div>
    <button class="btn-generate" id="btn-generate" onclick="generate()">✦ Generar concepto de plano</button>
  </aside>
  <main class="canvas-area">
    <div class="canvas-toolbar">
      <div class="info" id="canvas-info">Sin plano generado</div>
      <div class="download-group">
        <a class="btn-dl pdf hidden" id="dl-pdf" href="#" download>⬇ PDF</a>
        <a class="btn-dl dxf hidden" id="dl-dxf" href="#" download>⬇ DXF / AutoCAD</a>
      </div>
    </div>
    <div class="canvas-viewport">
      <div class="state-screen" id="idle-screen">
        <div class="big-icon">🏡</div>
        <h3>Tu plano aparecerá aquí</h3>
        <p>Completa las especificaciones y haz clic en <strong>"Generar concepto"</strong>.</p>
      </div>
      <div class="state-screen loading-screen" id="loading-screen">
        <div class="spinner"></div>
        <h3>Analizando tu terreno…</h3>
        <div class="loading-steps">
          <div class="step" id="step1">① Procesando imágenes del terreno</div>
          <div class="step" id="step2">② Claude genera distribución arquitectónica</div>
          <div class="step" id="step3">③ Exportando PDF y DXF</div>
        </div>
      </div>
      <div id="floor-plan-container"></div>
    </div>
  </main>
</div>
<script>
const ROOM_OPTIONS = [
  {id:"sala",label:"Sala",emoji:"🛋️"},{id:"comedor",label:"Comedor",emoji:"🍽️"},
  {id:"cocina",label:"Cocina",emoji:"🍳"},{id:"habitacion",label:"Hab. principal",emoji:"🛏️"},
  {id:"habitacion2",label:"Hab. 2",emoji:"🛏️"},{id:"habitacion3",label:"Hab. 3",emoji:"🛏️"},
  {id:"bano",label:"Baño social",emoji:"🚿"},{id:"bano2",label:"Baño privado",emoji:"🛁"},
  {id:"garaje",label:"Garaje",emoji:"🚗"},{id:"patio",label:"Patio / jardín",emoji:"🌿"},
  {id:"zona_lavado",label:"Zona lavado",emoji:"🧺"},{id:"estudio",label:"Estudio",emoji:"💻"},
];
const ROOM_COLORS = {
  sala:"#4fc3f7", comedor:"#ffcc80", cocina:"#a5d6a7", habitacion:"#ce93d8",
  habitacion2:"#b39ddb", habitacion3:"#9fa8da",
  bano:"#90caf9", bano2:"#80d8ff", baño:"#90caf9", baño2:"#80d8ff",
  garaje:"#b0bec5", patio:"#80cbc4", corredor:"#cccccc",
  escalera:"#e0c88a", zona_lavado:"#80deea", estudio:"#ef9a9a", otro:"#e0e0e0"
};
const DEFAULT_CHECKED = ["sala","comedor","cocina","habitacion","habitacion2","bano","patio","zona_lavado"];
const grid = document.getElementById("rooms-grid");
ROOM_OPTIONS.forEach(r => {
  const chip = document.createElement("label");
  chip.className = "room-chip";
  chip.innerHTML = `<input type="checkbox" value="${r.id}" onchange="updateChip(this)"/> ${r.emoji} ${r.label}`;
  grid.appendChild(chip);
  if (DEFAULT_CHECKED.includes(r.id)) { chip.querySelector("input").checked=true; chip.classList.add("checked"); }
});
function updateChip(cb) { cb.closest("label").classList.toggle("checked", cb.checked); }

let uploadedFiles = [];
document.getElementById("photo-input").addEventListener("change", function(e) {
  uploadedFiles = Array.from(e.target.files).slice(0,5);
  const strip = document.getElementById("preview-strip");
  strip.innerHTML = "";
  uploadedFiles.forEach(f => { const img=document.createElement("img"); img.className="preview-thumb"; img.src=URL.createObjectURL(f); strip.appendChild(img); });
});

async function generate() {
  hideError();
  const btn = document.getElementById("btn-generate");
  btn.disabled = true;
  const checkedRooms = Array.from(document.querySelectorAll(".room-chip input:checked")).map(cb=>cb.value);
  if (checkedRooms.length===0) { showError("Selecciona al menos un espacio."); btn.disabled=false; return; }
  const specs = {
    project_name: document.getElementById("project_name").value||"Casa familiar",
    location: document.getElementById("location").value||"Colombia",
    terrain_width: parseFloat(document.getElementById("terrain_width").value)||10,
    terrain_depth: parseFloat(document.getElementById("terrain_depth").value)||20,
    orientation: document.getElementById("orientation").value,
    floors: parseInt(document.getElementById("floors").value)||1,
    rooms: checkedRooms,
    notes: document.getElementById("notes").value,
  };
  showLoading();
  const stepAnim = animateSteps();
  try {
    const formData = new FormData();
    formData.append("specs", JSON.stringify(specs));
    uploadedFiles.forEach(f => formData.append("images", f));
    const res = await fetch("/generate", {method:"POST", body:formData});
    const data = await res.json();
    clearInterval(stepAnim);
    if (!res.ok || !data.success) throw new Error(data.detail||data.error||"Error desconocido");
    renderFloorPlan(data.layout, specs);
    setupDownloads(data.downloads);
    updateInfo(data.layout);
  } catch(err) {
    clearInterval(stepAnim);
    hideLoading();
    showError("❌ "+err.message);
  }
  btn.disabled = false;
}

function animateSteps() {
  const steps=["step1","step2","step3"]; let i=0;
  steps.forEach(s=>document.getElementById(s).classList.remove("active"));
  document.getElementById(steps[0]).classList.add("active");
  return setInterval(()=>{ if(i<steps.length-1){document.getElementById(steps[i]).classList.remove("active");i++;document.getElementById(steps[i]).classList.add("active");} },3500);
}

// ─── Helpers SVG ─────────────────────────────────────────────────────────────

function hexToRgba(hex, alpha) {
  // Soporta colores cortos (#abc) y largos (#aabbcc)
  let h = hex.replace("#","");
  if (h.length === 3) h = h[0]+h[0]+h[1]+h[1]+h[2]+h[2];
  const r=parseInt(h.slice(0,2),16), g=parseInt(h.slice(2,4),16), b=parseInt(h.slice(4,6),16);
  return `rgba(${r},${g},${b},${alpha})`;
}

function svgEl(tag, attrs={}) {
  const el = document.createElementNS("http://www.w3.org/2000/svg", tag);
  Object.entries(attrs).forEach(([k,v]) => el.setAttribute(k, v));
  return el;
}

function getColor(type) {
  if (!type) return ROOM_COLORS["otro"];
  // Normalizar: quitar tildes y probar directo
  const t = type.toLowerCase();
  return ROOM_COLORS[t] || ROOM_COLORS[t.replace(/\d+/g,"")] || ROOM_COLORS["otro"];
}

/**
 * Dibuja un espacio (room) con texto que NUNCA desborda el rect.
 * - ClipPath por cada rect
 * - Font-size proporcional: sqrt(area_px) / 6, clampado [8, 13]
 * - Si el espacio es muy angosto, omite texto
 */
function drawRoom(svg, rx, ry, rw, rd, color, room, uid) {
  const g = svgEl("g");

  // ClipPath
  const clipId = `clip-${uid}`;
  const defs = svgEl("defs");
  const clip = svgEl("clipPath", {id: clipId});
  // Inset de 3px para que el texto no toque el borde
  const cr = svgEl("rect", {x: rx+3, y: ry+3, width: Math.max(0,rw-6), height: Math.max(0,rd-6)});
  clip.appendChild(cr);
  defs.appendChild(clip);
  g.appendChild(defs);

  // Rect principal
  const rect = svgEl("rect", {
    x: rx, y: ry, width: rw, height: rd,
    fill: hexToRgba(color, 0.2),
    stroke: hexToRgba(color, 0.8),
    "stroke-width": "1.5"
  });
  const title = svgEl("title");
  title.textContent = `${room.name || room.id}\n${room.width_m}m × ${room.depth_m}m = ${room.area_m2} m²`;
  rect.appendChild(title);
  rect.addEventListener("mouseenter", () => rect.setAttribute("fill", hexToRgba(color, 0.38)));
  rect.addEventListener("mouseleave", () => rect.setAttribute("fill", hexToRgba(color, 0.2)));
  g.appendChild(rect);

  // Texto solo si el rect tiene tamaño mínimo
  if (rw >= 28 && rd >= 22) {
    // Font proporcional al área del rect en px
    const fs = Math.max(8, Math.min(13, Math.sqrt(rw * rd) / 6));
    const cx = rx + rw / 2;
    const cy = ry + rd / 2;

    const tg = svgEl("g", {"clip-path": `url(#${clipId})`});

    // Nombre: truncar si es muy largo para el ancho disponible
    const rawName = (room.name || room.id || "").toUpperCase();
    // Estimación: cada caracter ~= fs * 0.6px de ancho
    const maxChars = Math.max(2, Math.floor((rw - 8) / (fs * 0.62)));
    const displayName = rawName.length > maxChars ? rawName.slice(0, maxChars-1)+"…" : rawName;

    const nameEl = svgEl("text", {
      x: cx,
      y: rd > 36 ? cy - fs * 0.55 : cy + fs * 0.35,
      fill: color,
      "font-size": fs.toFixed(1),
      "text-anchor": "middle",
      "dominant-baseline": "middle",
      "font-family": "DM Sans, sans-serif",
      "font-weight": "600",
      "letter-spacing": "0.03em"
    });
    nameEl.textContent = displayName;
    tg.appendChild(nameEl);

    // Área — solo si hay espacio vertical suficiente
    if (rd > 36) {
      const fsA = Math.max(7, fs * 0.78);
      const areaEl = svgEl("text", {
        x: cx,
        y: cy + fs * 0.85,
        fill: "#8a8880",
        "font-size": fsA.toFixed(1),
        "text-anchor": "middle",
        "dominant-baseline": "middle",
        "font-family": "DM Mono, monospace"
      });
      areaEl.textContent = `${room.area_m2} m²`;
      tg.appendChild(areaEl);
    }

    g.appendChild(tg);
  }

  svg.appendChild(g);
}

function drawNorthArrow(svg, x, y) {
  const g = svgEl("g");
  g.appendChild(svgEl("line", {x1:x, y1:y+14, x2:x, y2:y-14, stroke:"#c9a84c", "stroke-width":"1.5"}));
  g.appendChild(svgEl("polygon", {points:`${x},${y-14} ${x-5},${y-2} ${x+5},${y-2}`, fill:"#c9a84c"}));
  const n = svgEl("text", {x, y:y-19, fill:"#c9a84c", "font-size":"10", "text-anchor":"middle", "font-family":"DM Mono"});
  n.textContent = "N";
  g.appendChild(n);
  svg.appendChild(g);
}

function drawDimLabel(svg, x, y, text, extra={}) {
  const el = svgEl("text", {
    x, y, fill:"#6a6860", "font-size":"10.5",
    "text-anchor":"middle", "font-family":"DM Mono", ...extra
  });
  el.textContent = text;
  svg.appendChild(el);
}

function drawRetiros(svg, PAD_L, PAD_T, tw, td, PX) {
  const s = {stroke:"rgba(201,168,76,0.2)", "stroke-width":"0.7", "stroke-dasharray":"3 4"};
  // Retiro frente (y=3)
  svg.appendChild(svgEl("line", {x1:PAD_L, y1:PAD_T+(td-3)*PX, x2:PAD_L+tw*PX, y2:PAD_T+(td-3)*PX, ...s}));
  // Retiro fondo (y=td-3)
  svg.appendChild(svgEl("line", {x1:PAD_L, y1:PAD_T+3*PX, x2:PAD_L+tw*PX, y2:PAD_T+3*PX, ...s}));
  // Retiro lateral izq (x=1.5)
  svg.appendChild(svgEl("line", {x1:PAD_L+1.5*PX, y1:PAD_T, x2:PAD_L+1.5*PX, y2:PAD_T+td*PX, ...s}));
  // Retiro lateral der (x=tw-1.5)
  svg.appendChild(svgEl("line", {x1:PAD_L+(tw-1.5)*PX, y1:PAD_T, x2:PAD_L+(tw-1.5)*PX, y2:PAD_T+td*PX, ...s}));
}

// ─── Render principal ─────────────────────────────────────────────────────────

function renderFloorPlan(layout, specs) {
  hideLoading();
  document.getElementById("idle-screen").style.display = "none";
  const container = document.getElementById("floor-plan-container");
  container.style.display = "block";
  container.innerHTML = "";

  const terrain = layout.terrain || {};
  const tw = parseFloat(terrain.width_m || 10);
  const td = parseFloat(terrain.depth_m || 20);

  // Escala adaptativa: máx 50px/m para terrenos pequeños, mín 28px/m para grandes
  const maxDim = Math.max(tw, td);
  const PX = Math.max(28, Math.min(50, 600 / maxDim));

  const PAD_T = 48;   // padding top
  const PAD_B = 36;   // padding bottom (espacio para "CALLE")
  const PAD_L = 58;   // padding left (etiqueta fondo)
  const PAD_R = 32;   // padding right

  let uid = 0;

  (layout.floors || []).forEach((floor, fi) => {
    const wrapper = document.createElement("div");
    wrapper.style.cssText = "display:inline-block;margin:0.5rem 1.5rem 1.5rem;vertical-align:top;";

    // Label piso
    const label = document.createElement("div");
    label.style.cssText = "font-family:'DM Mono',monospace;font-size:0.68rem;color:#c9a84c;letter-spacing:0.12em;margin-bottom:0.5rem;text-transform:uppercase;";
    label.textContent = `━━ PISO ${floor.floor_number || fi+1}`;
    wrapper.appendChild(label);

    const svgW = tw * PX + PAD_L + PAD_R;
    const svgH = td * PX + PAD_T + PAD_B;

    const svg = svgEl("svg");
    svg.setAttribute("width", svgW);
    svg.setAttribute("height", svgH);
    svg.setAttribute("xmlns", "http://www.w3.org/2000/svg");

    // Fondo del terreno
    svg.appendChild(svgEl("rect", {
      x: PAD_L, y: PAD_T, width: tw*PX, height: td*PX,
      fill: "rgba(201,168,76,0.05)", stroke: "#c9a84c",
      "stroke-width": "1.8", "stroke-dasharray": "6 3"
    }));

    // Líneas de retiro
    drawRetiros(svg, PAD_L, PAD_T, tw, td, PX);

    // Etiqueta ancho (arriba)
    drawDimLabel(svg, PAD_L + tw*PX/2, PAD_T - 14, `${tw.toFixed(1)} m`);

    // Etiqueta fondo (izquierda, rotada)
    drawDimLabel(svg, PAD_L - 22, PAD_T + td*PX/2, `${td.toFixed(1)} m`, {
      transform: `rotate(-90, ${PAD_L-22}, ${PAD_T + td*PX/2})`
    });

    // Label CALLE (abajo)
    const calleEl = svgEl("text", {
      x: PAD_L + tw*PX/2, y: PAD_T + td*PX + 22,
      fill: "#c9a84c", "font-size": "9.5", "text-anchor": "middle",
      "font-family": "DM Mono", "letter-spacing": "0.14em"
    });
    calleEl.textContent = "▲  CALLE / FRENTE";
    svg.appendChild(calleEl);

    // ── Rooms ─────────────────────────────────────────────────────────────
    (floor.rooms || []).forEach(room => {
      const xm = parseFloat(room.x_m || 0);
      const ym = parseFloat(room.y_m || 0);
      const wm = parseFloat(room.width_m || 3);
      const dm = parseFloat(room.depth_m || 3);

      const rw = wm * PX;
      const rd = dm * PX;
      const rx = PAD_L + xm * PX;
      // INVERSIÓN EJE Y: y=0 es calle (abajo en SVG)
      const ry = PAD_T + (td - ym - dm) * PX;

      const color = getColor(room.type);
      uid++;
      drawRoom(svg, rx, ry, rw, rd, color, room, `r${fi}-${uid}`);
    });

    // ── Circulaciones ──────────────────────────────────────────────────────
    (floor.circulations || []).forEach(circ => {
      const xm = parseFloat(circ.x_m || 0);
      const ym = parseFloat(circ.y_m || 0);
      const wm = parseFloat(circ.width_m || 1);
      const dm = parseFloat(circ.depth_m || 1);

      const cx = PAD_L + xm * PX;
      const cy = PAD_T + (td - ym - dm) * PX;  // misma inversión Y

      svg.appendChild(svgEl("rect", {
        x: cx, y: cy, width: wm*PX, height: dm*PX,
        fill: "rgba(255,255,255,0.04)",
        stroke: "rgba(255,255,255,0.2)",
        "stroke-width": "1",
        "stroke-dasharray": "4 3"
      }));
    });

    // Flecha norte
    drawNorthArrow(svg, PAD_L + tw*PX - 20, PAD_T + 22);

    wrapper.appendChild(svg);

    // Notas y advertencias
    if (layout.general_notes && fi === 0) {
      const n = document.createElement("div");
      n.style.cssText = `max-width:${svgW}px;margin-top:0.5rem;font-size:0.71rem;color:#7a7870;line-height:1.55;`;
      n.textContent = "📋 " + layout.general_notes;
      wrapper.appendChild(n);
    }
    if (layout.warnings && layout.warnings.length > 0 && fi === 0) {
      const w = document.createElement("div");
      w.style.cssText = `max-width:${svgW}px;margin-top:0.35rem;font-size:0.71rem;color:#e07060;line-height:1.55;`;
      w.innerHTML = layout.warnings.map(w => `⚠ ${w}`).join("<br/>");
      wrapper.appendChild(w);
    }

    container.appendChild(wrapper);
  });
}

// ─── Utilidades ───────────────────────────────────────────────────────────────

function setupDownloads(d) {
  if (!d) return;
  const pdf=document.getElementById("dl-pdf"), dxf=document.getElementById("dl-dxf");
  if (d.pdf) { pdf.href=d.pdf; pdf.classList.remove("hidden"); }
  if (d.dxf) { dxf.href=d.dxf; dxf.classList.remove("hidden"); }
}
function updateInfo(layout) {
  const rooms=(layout.floors||[]).flatMap(f=>f.rooms||[]);
  const total=rooms.reduce((s,r)=>s+parseFloat(r.area_m2||0),0);
  document.getElementById("canvas-info").textContent=
    `${layout.terrain?.width_m}m × ${layout.terrain?.depth_m}m · ${rooms.length} espacios · ${total.toFixed(1)} m²`;
}
function showLoading() {
  document.getElementById("idle-screen").style.display="none";
  document.getElementById("floor-plan-container").style.display="none";
  document.getElementById("loading-screen").style.display="flex";
}
function hideLoading() { document.getElementById("loading-screen").style.display="none"; }
function showError(msg) { const el=document.getElementById("error-msg"); el.style.display="block"; el.textContent=msg; }
function hideError() { document.getElementById("error-msg").style.display="none"; }
</script>
</body>
</html>
